# ---------------------------------------------------------------------------
#  Variables d'environnement — Compte rendu de diagnostic (Next.js / Vercel)
#  Copiez ce fichier en .env.local pour le développement, et renseignez les
#  mêmes clés dans Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Rédaction du compte rendu (Google Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Transcription audio (Groq Whisper, gratuit). https://console.groq.com/keys
GROQ_API_KEY=

# Les immeubles et les personnes concernées sont saisis directement dans l'outil
# (bibliothèque locale du navigateur) : aucune clé supplémentaire n'est nécessaire.

# --- Authentification -------------------------------------------------------
# Compte unique autorisé.
AUTH_EMAIL=test@test.com
# Empreinte scrypt du mot de passe. Générez-la avec :  npm run hash -- "votre-mdp"
# (valeur ci-dessous = empreinte de "test", à remplacer en production)
AUTH_PASSWORD_HASH=
# Clé secrète de signature des sessions (32+ octets aléatoires).
# Générez-en une avec :  openssl rand -hex 32
SESSION_SECRET=

# --- Maîtrise d'oeuvre (l'agence) -----------------------------------------
# Coordonnées de l'architecte en charge : ajoutées d'office aux participants
# et au tableau de contacts du document. Rien de réel ici, le dépôt est public.
MOE_ORGANISME=NOM DE L'AGENCE
MOE_NOM=M. Untel, architecte DPLG, architecte de copropriété
# Plusieurs numéros : les séparer par \n dans une valeur entre guillemets.
MOE_TEL="01 23 45 67 89\n06 12 34 56 78"
MOE_EMAIL=contact@exemple.fr
